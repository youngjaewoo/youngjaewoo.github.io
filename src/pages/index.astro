---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostPreview from "../components/PostPreview.astro";
import { siteUrl } from "../utils/urls";

const posts = (await getCollection("post"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 10);
---
<Base title="Home">
  <section class="intro">
    <h1>Code, Causality, and Discovery</h1>
    <p>Beyond my core research in human genetics, I actively enjoy exploring the latest machine learning methodologies with fellow bio-pharma professionals. I help lead local knowledge-exchange groups—such as the KASBP-SD community—where we discuss recent AI literature, share computational tools, and evaluate their real-world utility. This website serves as a digital extension of those conversations. Here, you can expect a wide range of content: from technical deep dives into frontier deep learning architectures to accessible, straightforward guides on applying AI tools to everyday biological research.</p>
  </section>
  <section class="post-section" aria-labelledby="post-heading">
    <h2 class="section-title" id="post-heading"><a href={siteUrl("posts/")}>Posts</a></h2>
    {posts.length > 0 ? <ul class="post-list">{posts.map((post) => <li><PostPreview post={post} /></li>)}</ul> : <p class="muted">No posts yet. Add a Markdown file to <code>content/posts/</code> to get started.</p>}
  </section>
</Base>
