---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;
---
<div class="post-preview">
  <time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</time>
  <a class="post-link" href={`/posts/${post.id}/`}>{post.data.title}</a>
</div>
