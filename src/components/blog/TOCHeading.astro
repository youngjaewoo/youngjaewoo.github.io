---
import type { TocItem } from "../../utils/generateToc";

const { heading } = Astro.props as { heading: TocItem };
---

<li class:list={{ "toc-subitem": heading.depth > 2 }}>
  <a class:list={{ "toc-subheading": heading.depth > 2 }} href={`#${heading.slug}`}><span aria-hidden="true">#</span>{heading.text}</a>
  {heading.children.length > 0 && <ol>{heading.children.map((child) => <Astro.self heading={child} />)}</ol>}
</li>