---
import "@pagefind/component-ui/css";
---

<script>
  if (!import.meta.env.DEV) {
    const onIdle = window.requestIdleCallback || ((callback) => setTimeout(callback, 1));
    onIdle(() => import("@pagefind/component-ui"));
  }
</script>

<pagefind-config
  baseUrl={`${import.meta.env.BASE_URL}`}
  bundle-path={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/pagefind/`}
></pagefind-config>
<pagefind-modal-trigger id="search" hide-shortcut compact></pagefind-modal-trigger>
<pagefind-modal></pagefind-modal>